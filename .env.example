# RetailLens environment variables template
# Copy to .env and fill in actual values. NEVER commit .env.

# ===== Kaggle =====
# Used by scripts/download_olist.sh
KAGGLE_USERNAME=
KAGGLE_KEY=

# ===== Supabase =====
# Project URL: https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Postgres connection (from Settings → Database)
# Used by dbt and pipeline sync scripts
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Storage bucket name for DuckDB + ChromaDB tarball
SUPABASE_STORAGE_BUCKET=retaillens-artifacts

# ===== LLM =====
# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ===== Deployment =====
# Render API URL (will be set after W10)
RENDER_API_URL=https://retaillens-api.onrender.com

# ===== Monitoring (optional in W1) =====
SLACK_WEBHOOK_URL=
UPTIMEROBOT_API_KEY=

# ===== Pipeline config =====
PIPELINE_BATCH_SIZE=10000
PIPELINE_LOG_LEVEL=INFO

# ===== Dev =====
ENVIRONMENT=development
DEBUG=true